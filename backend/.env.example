# ===== 方式一：官方 Anthropic API =====
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
# ANTHROPIC_BASE_URL=
# CLAUDE_MODEL=claude-sonnet-4-5-20250929

# ===== 方式二：通过本地 Anthropic 兼容代理 =====
# 适用于将请求转发到任意 Anthropic 兼容端点的本地代理。
# BASE_URL 指向你的本地代理地址，API_KEY 按代理要求填写（无校验时可任意填）。
ANTHROPIC_BASE_URL=http://127.0.0.1:23333/api/anthropic
ANTHROPIC_API_KEY=your-token-here
CLAUDE_MODEL=claude-sonnet-4-5-20250929

# 允许的前端来源 (CORS)
CORS_ORIGINS=http://localhost:5173

# 自动修订循环最大轮数（0 表示只审不改）
REVIEW_RETRIES=1
