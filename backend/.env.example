# ===== 方式一：官方 Anthropic API =====
# ANTHROPIC_API_KEY=<your-anthropic-api-key>
# ANTHROPIC_BASE_URL=
# CLAUDE_MODEL=claude-sonnet-4-5-20250929

# ===== 方式二：通过本地 Anthropic 兼容代理 =====
# 适用于将请求转发到任意 Anthropic 兼容端点的本地代理。
# BASE_URL 指向你的本地代理地址，API_KEY 按代理要求填写（无校验时可任意填）。
ANTHROPIC_BASE_URL=http://127.0.0.1:23333/api/anthropic
ANTHROPIC_API_KEY=<your-proxy-token-or-placeholder>
CLAUDE_MODEL=claude-sonnet-4-5-20250929

# ===== 方式三：通过 .claude/settings.json 的 Agent Maestro 配置 =====
# 如果 backend/.env 不存在，后端会自动读取仓库根目录的 .claude/settings.json：
# ANTHROPIC_BASE_URL / ANTHROPIC_AUTH_TOKEN / ANTHROPIC_MODEL
# 这种方式无需复制 token 到 backend/.env。

# 允许的前端来源 (CORS)
CORS_ORIGINS=http://localhost:5173

# 自动修订循环最大轮数（0 表示只审不改）
REVIEW_RETRIES=1
